{
    "compilerOptions": { 
        "target": "ESNext",
        "ignoreDeprecations": "6.0",
        "moduleResolution": "Node",
        "noEmit": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["jest"],
    },
    "include": ["./src/**/*", "./test/**/*"],
}
